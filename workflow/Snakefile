rule run_SeqNeighbor:
    input:
        fasta="data/regional_reads/{sample}/{region}/{platform}/reads.fasta.gz",
    output:
        folder=directory("data/FEDRANN/{sample}/{region}/{platform}/v53_k{kmer_size}_s{kmer_sample}_d{embedding_dimension}_n{trees}_f{threshold}_neighbors{neighbors}/"),
        tsv="data/FEDRANN/{sample}/{region}/{platform}/v53_k{kmer_size}_s{kmer_sample}_d{embedding_dimension}_n{trees}_f{threshold}_neighbors{neighbors}/overlaps.tsv",
        log="data/FEDRANN/{sample}/{region}/{platform}/v53_k{kmer_size}_s{kmer_sample}_d{embedding_dimension}_n{trees}_f{threshold}_neighbors{neighbors}/FEDRANN_time.log",
    threads: 64
    params:
        kmer_sample_fraction=lambda wildcards: int(wildcards["kmer_sample"])/100,
        image="fedrann:0.5.3.1"
    shell:
        """
            docker run -t --rm -v /home:/home  -w $(pwd) --user $(id -u):$(id -g) \
            {params.image} /usr/bin/time -v -o {output.log} \
            fedrann \
                -i {input.fasta} \
                -o {output.folder} \
                -k {wildcards.kmer_size} \
                --kmer-sample-fraction {params.kmer_sample_fraction} \
                --seed 602 \
                --kmer-min-multiplicity {wildcards.threshold} \
                --embedding-dimension {wildcards.embedding_dimension} \
                --nndescent-n-trees {wildcards.trees} \
                --nndescent-n-neighbors {wildcards.neighbors} \
                --threads {threads} \
                --mprof
        """

rule get_neighbors_txt1:
    input:
        metadata="data/regional_reads/{sample}/{region}/{platform}/metadata.tsv.gz",
        paf_minimap2="data/FEDRANN/{sample}/{region}/{platform}/{parameters}_neighbors{neighbors}/overlaps.tsv",
    output:
        nbr_indice="data/evaluation64/{sample}/{region}/{platform}/{parameters}_neighbors{neighbors}/FEDRANN_nbr_matrix.npz",
        time="data/evaluation64/{sample}/{region}/{platform}/{parameters}_neighbors{neighbors}/FEDRANN_nn_time_tmp.json",
    threads: 1
    wildcard_constraints:
        sample=r'(CHM13|rice|ara|droso|caenor)',
    conda:
        "envs/evaluate.yaml"
    shell:
        """
        python workflow/scripts/get_neighbors.smk.py --input {input.metadata} {input.paf_minimap2} \
        --output {output.nbr_indice} {output.time} --method FEDRANN --threads {threads}  --n-neighbors {wildcards.neighbors}
        """


rule filter_paf:
    input:
        paf="data/{biosoft}/{sample}/{region}/{platform}/hash_k21/alignment.paf",
    output:
        filter_paf="data/{biosoft}/{sample}/{region}/{platform}/hash_k21/filter_alignment.paf.gz",
    shell:
        """
        awk '$10 >= 50 && ($10/$11) >= 0.1' {input.paf} | gzip -c > {output.filter_paf}
        """

